# Esempio: copia in .env.local e compila. Non inserire mai valori reali in questo file.
# Valori da Supabase › Project Settings › API Keys (progetto di prova).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chiave segreta: solo sul server, mai con il prefisso NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Facoltativo, solo sul Mac: indirizzo diretto del database DI PROVA per npm run test:db
# (contiene la password del database: non va mai in chat né su GitHub).
SUPABASE_DB_URL=
